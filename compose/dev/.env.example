# Docker Compose variables for compose/dev (development only; placeholders).
# Copy to compose/dev/.env (git-ignored) and change the passwords.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=r007_dev
MYSQL_USER=r007_app
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3306
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Bind addresses: 127.0.0.1 keeps services private to this machine. Use 0.0.0.0 only for a LAN demo.
MYSQL_BIND=127.0.0.1
REDIS_BIND=127.0.0.1
MAILPIT_BIND=127.0.0.1

# --- optional `reverb` profile ---
# Path to your 007resort-api checkout (vendor/ must be installed).
R007_API_DIR=../../../007resort-api
REVERB_PORT=8081
REVERB_BIND=127.0.0.1
REVERB_APP_ID=r007-dev
REVERB_APP_KEY=r007-dev-key
REVERB_APP_SECRET=dev-only-secret
