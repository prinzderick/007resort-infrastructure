# =============================================================================
# Otueke - CLOUD deployment environment template
# =============================================================================
# PLACEHOLDERS ONLY. Real values live in the cloud provider's secret manager /
# app settings - NEVER in git.
#
# Services: Otueke API (cloud mode), managed MySQL 8.4, otueke-booking-web
#           (public), otueke-admin-web (remote management).
# Sync is initiated OUTBOUND by each site; the cloud never connects into a site.
# Values marked <secret> must be generated per environment and stored securely.
# =============================================================================

# -----------------------------------------------------------------------------
# Otueke API (cloud mode)
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080           # behind the provider's TLS load balancer
OTUEKE__DEPLOYMENTMODE=cloud
OTUEKE__TIMEZONE=Africa/Lagos
OTUEKE__PUBLICBASEURL=https://api.cloud.example.com

# Managed MySQL 8.4 (TLS required)
ConnectionStrings__Otueke=Server=mysql.cloud.example.com;Port=3306;Database=otueke;User ID=otueke_app;Password=<secret>;SslMode=Required;
# ConnectionStrings__OtuekeMigrations=Server=mysql.cloud.example.com;Port=3306;Database=otueke;User ID=otueke_migrator;Password=<secret>;SslMode=Required;
ConnectionStrings__Redis=

OTUEKE__AUTH__SIGNINGKEY=<secret>
OTUEKE__AUTH__ISSUER=https://api.cloud.example.com
OTUEKE__AUTH__ACCESSTOKENMINUTES=30

# Sites allowed to sync (credentials are per site and stored in the secret manager).
OTUEKE__SYNC__ACCEPTSITES=SITE-PLACEHOLDER-001

# Payment provider - callbacks/webhooks are received by the API only.
OTUEKE__PAYMENTS__PROVIDER=placeholder
OTUEKE__PAYMENTS__PUBLICKEY=pk_placeholder
OTUEKE__PAYMENTS__SECRETKEY=<secret>
OTUEKE__PAYMENTS__WEBHOOKSECRET=<secret>
OTUEKE__PAYMENTS__CALLBACKURL=https://api.cloud.example.com/api/v1/payments/webhooks/placeholder

# Outgoing mail (booking confirmations)
OTUEKE__MAIL__HOST=smtp.example.com
OTUEKE__MAIL__PORT=587
OTUEKE__MAIL__USERNAME=<secret>
OTUEKE__MAIL__PASSWORD=<secret>
OTUEKE__MAIL__FROM=no-reply@example.com

Serilog__MinimumLevel__Default=Information

# -----------------------------------------------------------------------------
# otueke-booking-web (public website + customer portal)
# -----------------------------------------------------------------------------
BOOKING_APP_NAME="Otueke Booking"
BOOKING_APP_ENV=production
BOOKING_APP_KEY=<secret>                      # php artisan key:generate --show
BOOKING_APP_DEBUG=false
BOOKING_APP_URL=https://www.example.com
BOOKING_OTUEKE_API_BASE_URL=https://api.cloud.example.com
BOOKING_OTUEKE_API_CLIENT_ID=otueke-booking-web
BOOKING_OTUEKE_DISPLAY_TIMEZONE=Africa/Lagos
BOOKING_SESSION_DRIVER=file                   # use redis/database only via ADR when scaling out
BOOKING_SESSION_SECURE_COOKIE=true
BOOKING_CACHE_STORE=file
BOOKING_QUEUE_CONNECTION=sync

# -----------------------------------------------------------------------------
# otueke-admin-web (remote management)
# -----------------------------------------------------------------------------
ADMIN_APP_NAME="Otueke Admin"
ADMIN_APP_ENV=production
ADMIN_APP_KEY=<secret>
ADMIN_APP_DEBUG=false
ADMIN_APP_URL=https://admin.cloud.example.com
ADMIN_OTUEKE_API_BASE_URL=https://api.cloud.example.com
ADMIN_OTUEKE_API_CLIENT_ID=otueke-admin-web
ADMIN_OTUEKE_DISPLAY_TIMEZONE=Africa/Lagos
ADMIN_SESSION_DRIVER=file
ADMIN_SESSION_SECURE_COOKIE=true
ADMIN_CACHE_STORE=file
ADMIN_QUEUE_CONNECTION=sync

# NOTE: in each Laravel app's .env the keys are written without the
# BOOKING_/ADMIN_ prefix (e.g. APP_KEY, OTUEKE_API_BASE_URL).
