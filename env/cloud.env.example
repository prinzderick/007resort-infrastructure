# =============================================================================
# 007 Resort & Spa - CLOUD NODE (Ubuntu VPS) - Laravel .env template
# =============================================================================
# PLACEHOLDERS ONLY. The real file lives at /var/www/r007/api/shared/.env
# (owner deploy, group r007-api, mode 640: no access for anyone else). NEVER commit it.
#
# scripts/vps/provision-stack.sh creates the real file from this template and fills
# every value marked <generate> with a random secret. Values marked <secret> are
# filled by an administrator (paste over SSH, or use a secret manager).
#
# NOTE for API maintainers: keep in step with 007resort-api/.env.example (names follow
# docs/architecture 25 and ADR-0012/0013).
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_NAME="007 Resort & Spa"
APP_ENV=production
APP_DEBUG=false
APP_KEY=<generate>                         # deploy.sh generates it on the first deploy if empty
APP_URL=https://api.example.com            # public HTTPS URL of this node
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_NODE=cloud                             # local | cloud  (ADR-0013)

LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info

# ---- Database (MySQL 8.4, bound to 127.0.0.1 - never public) ----------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=r007
DB_USERNAME=r007_app
DB_PASSWORD=<generate>
DB_MIGRATOR_USERNAME=r007_migrator
DB_MIGRATOR_PASSWORD=<generate>

# ---- Redis (bound to 127.0.0.1 - never public) ------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<generate>
REDIS_PREFIX=r007_cloud_

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
REDIS_QUEUE=default

# ---- Real-time (Laravel Reverb behind nginx TLS proxy: wss://<domain>/app) --------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=<generate>
REVERB_APP_KEY=<generate>
REVERB_APP_SECRET=<generate>
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=api.example.com
REVERB_PORT=443
REVERB_SCHEME=https

# ---- Node identity + Local<->Cloud sync (ADR-0013) ----------------------------------
NODE_SITE_ID=CLOUD-PLACEHOLDER
NODE_NAME=cloud-vps
SYNC_ENABLED=true
# Cloud never calls a Local node. Peer URL is empty unless a second Cloud/staging peer exists.
SYNC_PEER_URL=
# Sites this node accepts sync from. The per-site node credential is verified by the API
# (stored hashed); the plaintext credential is only ever configured on that site's Local node.
SYNC_ACCEPT_SITES=SITE-PLACEHOLDER-001
SYNC_NODE_CREDENTIAL=<secret>
SYNC_OFFLINE_THRESHOLD_SECONDS=90          # heartbeat staleness before a site is marked OFFLINE
SYNC_QUEUE=sync
SYNC_TIMEOUT_SECONDS=15

# ---- Payments: Paystack (ADR-0009). Webhooks terminate here. ------------------------
PAYSTACK_PUBLIC_KEY=pk_placeholder
PAYSTACK_SECRET_KEY=<secret>
PAYSTACK_WEBHOOK_SECRET=<secret>
PAYSTACK_CALLBACK_URL=https://api.example.com/api/v1/payments/webhooks/paystack

# ---- Website CMS (docs/CMS_API.md in 007resort-api) ---------------------------------
# Public website origin: newsletter confirm/unsubscribe links in emails are CMS_WEB_URL + /newsletter/confirm?token=...
# provision-stack.sh sets it to https://<SITE_DOMAIN>. Without it links point at a localhost placeholder.
CMS_WEB_URL=https://example.com
CMS_MEDIA_DISK=public                      # uploads land in shared/storage/app/public (nginx serves /storage/cms/*)
CMS_MEDIA_URL=                             # empty = <APP_URL>/storage; only set when a CDN fronts the media
CMS_SYNC_EMIT=false
CMS_TIMEZONE=Africa/Lagos

# ---- Mail (booking confirmations, newsletter confirmation, password resets) ---------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=<secret>
MAIL_PASSWORD=<secret>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"
