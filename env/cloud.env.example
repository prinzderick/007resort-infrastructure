# =============================================================================
# 007 Resort & Spa - CLOUD deployment environment template
# =============================================================================
# PLACEHOLDERS ONLY. Real values live in the cloud provider's secret manager /
# app settings - NEVER in git.
#
# Services: 007 Resort & Spa API (cloud mode), managed MySQL 8.4, 007resort-booking-web
#           (public), 007resort-admin-web (remote management).
# Sync is initiated OUTBOUND by each site; the cloud never connects into a site.
# Values marked <secret> must be generated per environment and stored securely.
# =============================================================================

# -----------------------------------------------------------------------------
# 007 Resort & Spa API (cloud mode)
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080           # behind the provider's TLS load balancer
R007__DEPLOYMENTMODE=cloud
R007__TIMEZONE=Africa/Lagos
R007__PUBLICBASEURL=https://api.cloud.example.com

# Managed MySQL 8.4 (TLS required)
ConnectionStrings__R007=Server=mysql.cloud.example.com;Port=3306;Database=r007;User ID=r007_app;Password=<secret>;SslMode=Required;
# ConnectionStrings__R007Migrations=Server=mysql.cloud.example.com;Port=3306;Database=r007;User ID=r007_migrator;Password=<secret>;SslMode=Required;
ConnectionStrings__Redis=

R007__AUTH__SIGNINGKEY=<secret>
R007__AUTH__ISSUER=https://api.cloud.example.com
R007__AUTH__ACCESSTOKENMINUTES=30

# Sites allowed to sync (credentials are per site and stored in the secret manager).
R007__SYNC__ACCEPTSITES=SITE-PLACEHOLDER-001

# Payment provider - callbacks/webhooks are received by the API only.
R007__PAYMENTS__PROVIDER=placeholder
R007__PAYMENTS__PUBLICKEY=pk_placeholder
R007__PAYMENTS__SECRETKEY=<secret>
R007__PAYMENTS__WEBHOOKSECRET=<secret>
R007__PAYMENTS__CALLBACKURL=https://api.cloud.example.com/api/v1/payments/webhooks/placeholder

# Outgoing mail (booking confirmations)
R007__MAIL__HOST=smtp.example.com
R007__MAIL__PORT=587
R007__MAIL__USERNAME=<secret>
R007__MAIL__PASSWORD=<secret>
R007__MAIL__FROM=no-reply@example.com

Serilog__MinimumLevel__Default=Information

# -----------------------------------------------------------------------------
# 007resort-booking-web (public website + customer portal)
# -----------------------------------------------------------------------------
BOOKING_APP_NAME="007 Resort & Spa Booking"
BOOKING_APP_ENV=production
BOOKING_APP_KEY=<secret>                      # php artisan key:generate --show
BOOKING_APP_DEBUG=false
BOOKING_APP_URL=https://www.example.com
BOOKING_R007_API_BASE_URL=https://api.cloud.example.com
BOOKING_R007_API_CLIENT_ID=007resort-booking-web
BOOKING_R007_DISPLAY_TIMEZONE=Africa/Lagos
BOOKING_SESSION_DRIVER=file                   # use redis/database only via ADR when scaling out
BOOKING_SESSION_SECURE_COOKIE=true
BOOKING_CACHE_STORE=file
BOOKING_QUEUE_CONNECTION=sync

# -----------------------------------------------------------------------------
# 007resort-admin-web (remote management)
# -----------------------------------------------------------------------------
ADMIN_APP_NAME="007 Resort & Spa Admin"
ADMIN_APP_ENV=production
ADMIN_APP_KEY=<secret>
ADMIN_APP_DEBUG=false
ADMIN_APP_URL=https://admin.cloud.example.com
ADMIN_R007_API_BASE_URL=https://api.cloud.example.com
ADMIN_R007_API_CLIENT_ID=007resort-admin-web
ADMIN_R007_DISPLAY_TIMEZONE=Africa/Lagos
ADMIN_SESSION_DRIVER=file
ADMIN_SESSION_SECURE_COOKIE=true
ADMIN_CACHE_STORE=file
ADMIN_QUEUE_CONNECTION=sync

# NOTE: in each Laravel app's .env the keys are written without the
# BOOKING_/ADMIN_ prefix (e.g. APP_KEY, R007_API_BASE_URL).
