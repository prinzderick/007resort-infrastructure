# =============================================================================
# 007 Resort & Spa - LOCAL NODE (property Windows Server) - Laravel .env template
# =============================================================================
# PLACEHOLDERS ONLY. The real file lives at C:\R007\shared\.env (ACL: Administrators,
# SYSTEM and the svc-r007 service account only). NEVER commit it.
#
# scripts/windows/install.ps1 copies this template to shared\.env when no file is
# supplied, and fills every value marked <generate> with a cryptographically random
# secret. Values marked <secret> are supplied by an administrator (secure prompt).
# Dev/demo: scripts/dev/local-node.sh exports the equivalent variables itself.
#
# NOTE for API maintainers: keep this file in step with 007resort-api/.env.example.
# Variable names below follow docs/architecture 25 + 26 and ADR-0012/0013; if the
# API renames a NODE_*/SYNC_* variable, change it here in the same release.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_NAME="007 Resort & Spa"
APP_ENV=production
APP_DEBUG=false
APP_KEY=<generate>                         # php artisan key:generate --show (install.ps1 does this)
APP_URL=http://r007-api.site.local         # what tablets/POS use on the property LAN (no trailing slash)
APP_TIMEZONE=UTC                           # storage/clock stays UTC; display timezone below
APP_DISPLAY_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_NODE=local                             # local | cloud  (ADR-0013)

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info

# ---- Database (MySQL 8.4, bound to 127.0.0.1) ---------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=r007
DB_USERNAME=r007_app
DB_PASSWORD=<generate>
# Migrations run with a separate DDL account, used only by update.ps1 (never by workers).
DB_MIGRATOR_USERNAME=r007_migrator
DB_MIGRATOR_PASSWORD=<generate>

# ---- Redis (Memurai / Redis-compatible, bound to 127.0.0.1) -----------------------
# Redis is cache/queue/broadcast transport only - never authoritative storage.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<generate>
REDIS_PREFIX=r007_local_

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
REDIS_QUEUE=default

# ---- Real-time (Laravel Reverb, run as a Windows service) -----------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=<generate>
REVERB_APP_KEY=<generate>
REVERB_APP_SECRET=<generate>
# Server side: listens on the SERVER VLAN interface; firewall limits who can connect.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8085
# Client side: what tablets/POS/KDS are told to connect to (LAN name, plain ws on the LAN).
REVERB_HOST=r007-api.site.local
REVERB_PORT=8085
REVERB_SCHEME=http

# ---- Node identity + Local<->Cloud sync (ADR-0013; outbound only) ---------------
NODE_SITE_ID=SITE-PLACEHOLDER-001          # this property's id as registered on the Cloud node
NODE_NAME=otueke-local
SYNC_ENABLED=true
SYNC_PEER_URL=https://api.cloud.example.com   # the Cloud node (HTTPS). Local always calls out; Cloud never calls in.
SYNC_NODE_CREDENTIAL=<secret>                 # issued at commissioning; rotate per runbooks/node-credential-rotation.md
SYNC_HEARTBEAT_INTERVAL_SECONDS=30
SYNC_QUEUE=sync
SYNC_TIMEOUT_SECONDS=15

# ---- Payments (Paystack webhooks terminate on the CLOUD node; Local holds no live keys) --
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ---- Mail (optional on Local; usually queued and sent by Cloud) ------------------
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=<secret>
MAIL_PASSWORD=<secret>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- Ops / deployment (read by scripts/windows/*.ps1, ignored by Laravel) -------------
R007_BACKUP_NAS_PATH=\\nas.site.local\r007-backups
R007_BACKUP_LOCAL_RETENTION_DAYS=7
R007_BACKUP_NAS_RETENTION_DAYS=35
