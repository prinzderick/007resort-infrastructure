# =============================================================================
# 007 Resort & Spa - VPS STACK SETTINGS (non-secret). Installed as /etc/r007/stack.env
# =============================================================================
# Read (as bash, `KEY=value`) by provision-stack.sh, tls.sh, deploy.sh, smoke.sh, backup.sh.
# NO secrets here: it is world-readable so the deploy user can use it. Secrets live in the per-app
# .env files and in /etc/r007/admin-basic-auth.secret (root only).
# Command-line flags of provision-stack.sh (--site-domain ...) override and are saved back to this file.
# =============================================================================

# ---- Public names (DNS A/AAAA for all of them must point at this VPS before `r007-tls`) ----
SITE_DOMAIN=example.com            # public website; also answers on www.<SITE_DOMAIN> (redirects to the apex)
API_DOMAIN=api.example.com         # API + Reverb websockets + uploaded media (/storage). REQUIRED
ADMIN_DOMAIN=admin.example.com     # admin portal. Leave empty to not host it (or to keep it private, see runbook)
SITE_WWW=on                        # on|off: also serve/redirect www.<SITE_DOMAIN> (needs its DNS record)
CERT_EMAIL=ops@example.com         # Let's Encrypt registration/expiry notices

# ---- System ----------------------------------------------------------------------------
DEPLOY_USER=deploy
APP_ROOT_BASE=/var/www/r007        # -> api/ site/ admin/, each with releases/ shared/ current
PHP_VER=8.4

# ---- How the site and admin reach the API (used only when their .env is first created) ---
# Empty = the public URL https://<API_DOMAIN>. Loopback alternative: http://127.0.0.1:8088
API_INTERNAL_URL=

# ---- Admin hardening ----------------------------------------------------------------------
# Space/comma separated IPs or CIDRs. Empty = reachable from the internet (login-protected).
# When set, everybody else gets 403 from nginx before the app sees the request.
ADMIN_ALLOW_IPS=
# on = an extra HTTP basic-auth layer in front of the portal login. The credentials come from
# ADMIN_BASIC_AUTH_SECRET_FILE ("user:password", root-only; generated if missing).
ADMIN_BASIC_AUTH=off
ADMIN_BASIC_AUTH_SECRET_FILE=/etc/r007/admin-basic-auth.secret

# ---- Optional -----------------------------------------------------------------------------
FPM_OPEN_BASEDIR=off               # on = jail each pool to its own app directory (test on staging first)
TLS_MIN_DAYS=14                    # smoke.sh fails when a certificate expires sooner than this
# Only for `deploy.sh <app> <git-ref>` (server-side clone). CI deploys prebuilt packages instead.
API_GIT_URL=
SITE_GIT_URL=
ADMIN_GIT_URL=
