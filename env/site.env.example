# =============================================================================
# 007 Resort & Spa - PUBLIC WEBSITE (007resort-booking-web) on the Cloud VPS - Laravel .env template
# =============================================================================
# PLACEHOLDERS ONLY. The real file lives at /var/www/r007/site/shared/.env
# (owner deploy, group r007-site, mode 640). NEVER commit it.
# scripts/vps/provision-stack.sh creates it from this template and fills the <generate> values / URLs.
# <secret> values are pasted by an administrator. Keep in step with 007resort-booking-web/.env.example.
# The site has NO database: every business fact comes from the API over HTTP.
# =============================================================================

APP_NAME="007 Resort & Spa"
APP_ENV=production
APP_DEBUG=false
APP_KEY=<generate>                          # deploy.sh generates it on the first deploy if empty
APP_URL=https://example.com                 # https://<SITE_DOMAIN>
R007_DISPLAY_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

# ---- The API (single owner of business data) --------------------------------------
# Default = public HTTPS URL. Loopback alternative (skips TLS + DNS, same box only): http://127.0.0.1:8088
R007_API_BASE_URL=https://api.example.com
R007_API_PREFIX=/api/v1
R007_API_TIMEOUT=10
R007_API_CONNECT_TIMEOUT=3
R007_API_CLIENT_ID=007resort-booking-web
# Service token of the "online" channel (r7s_...). Issue it on the API:
#   r007-artisan api r007:service-token create ...   (see 007resort-api docs/CUSTOMER_PUBLIC_API.md)
R007_API_SERVICE_TOKEN=<secret>
R007_MOCK=false                             # never true in production

# ---- Website content (CMS lives in the API) -----------------------------------------
CMS_FIXTURES=false                          # must be false in production (true = bundled demo content)
CMS_CACHE_TTL=60
CMS_STALE_TTL=86400
CMS_TIMEOUT=4
CMS_PAGE_MAX_AGE=60
# Media is served by the API domain (/storage/cms/*); list its origin so the CSP allows the images.
CMS_MEDIA_HOSTS=https://api.example.com
CMS_SUBSCRIBE_POPUP=true
SITE_VIEW_TRANSITIONS=true

# ---- Public contact details (the API's /public/site overrides these when available) ---
SITE_PHONE="+234 000 000 0000"
SITE_EMAIL=hello@example.com
SITE_ADDRESS="007 Resort & Spa, Otueke, Bayelsa State, Nigeria"
SITE_MAP_URL=

# ---- Behind nginx on this box -----------------------------------------------------------
# nginx passes HTTPS=on to PHP-FPM, so URLs/cookies are already correct. Only change TRUSTED_PROXIES
# when a CDN/load balancer sits in front of nginx (then list ITS addresses and use nginx real_ip).
TRUSTED_PROXIES=127.0.0.1

# ---- Sessions / cache: files under this app's own storage (isolated from the other apps) ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null                         # host-only cookie: never shared with api./admin. subdomains
SESSION_COOKIE=r007_site_session            # distinct name per app, defence in depth
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync                       # the site has no queue worker
CACHE_STORE=file
CACHE_PREFIX=r007_site_

# ---- Mail: the site sends none itself (the API mails newsletter/booking confirmations) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"
