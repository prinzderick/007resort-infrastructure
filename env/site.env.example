# =============================================================================
# 007 Resort & Spa - ON-SITE deployment environment template
# =============================================================================
# PLACEHOLDERS ONLY. Real values live in the site server's protected
# environment (Windows service environment / machine-level env vars readable
# only by the service account) or a secret store - NEVER in git.
#
# Host: Windows local application server (SERVER VLAN).
# Services: 007 Resort & Spa API (Windows service), MySQL 8.4, Redis (optional),
#           007resort-admin-web (local management UI).
# Values marked <secret> must be generated per site and stored securely.
# =============================================================================

# -----------------------------------------------------------------------------
# 007 Resort & Spa API (ASP.NET Core, runs as a Windows service)
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# Bind on the SERVER VLAN interface only (not 0.0.0.0 if avoidable).
ASPNETCORE_URLS=https://0.0.0.0:5443;http://0.0.0.0:5080
# Deployment mode: "site" (local-first, authoritative for on-site operations)
R007__DEPLOYMENTMODE=site
# Identifier of this property/site as registered in the cloud.
R007__SITEID=SITE-PLACEHOLDER-001
R007__TIMEZONE=Africa/Lagos

# MySQL connection (application user; least privilege on the r007 schema).
ConnectionStrings__R007=Server=127.0.0.1;Port=3306;Database=r007;User ID=r007_app;Password=<secret>;SslMode=Preferred;
# Migration user (DDL rights) used ONLY by the deployment step, not the running service.
# ConnectionStrings__R007Migrations=Server=127.0.0.1;Port=3306;Database=r007;User ID=r007_migrator;Password=<secret>;

# Optional Redis (caching / pub-sub for KDS). Leave empty to disable.
ConnectionStrings__Redis=127.0.0.1:6379,password=<secret>,abortConnect=false

# Token signing - generate per site (min 256-bit random). Rotate per runbook.
R007__AUTH__SIGNINGKEY=<secret>
R007__AUTH__ISSUER=https://r007-api.site.local
R007__AUTH__ACCESSTOKENMINUTES=30

# TLS certificate for the API (path to a PFX outside the repo; password in secret store).
R007__TLS__CERTIFICATEPATH=C:\R007\certs\r007-api.pfx
R007__TLS__CERTIFICATEPASSWORD=<secret>

# Cloud sync (OUTBOUND ONLY from site to cloud; the site accepts no inbound internet traffic).
R007__SYNC__ENABLED=true
R007__SYNC__CLOUDBASEURL=https://api.cloud.example.com
R007__SYNC__SITECLIENTID=site-placeholder-001
R007__SYNC__SITECLIENTSECRET=<secret>
R007__SYNC__INTERVALSECONDS=30

# Logging
Serilog__MinimumLevel__Default=Information
R007__LOGGING__PATH=C:\R007\logs\api

# -----------------------------------------------------------------------------
# MySQL 8.4 (local)
# -----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=r007
# Backups read credentials from a protected option file - never from here.
MYSQL_BACKUP_OPTION_FILE=C:\R007\secrets\mysql-backup.cnf
BACKUP_LOCAL_PATH=D:\R007Backups
BACKUP_NAS_PATH=\\nas.site.local\r007-backups
BACKUP_RETENTION_DAYS=35

# -----------------------------------------------------------------------------
# 007resort-admin-web (local management UI, STAFF VLAN access only)
# -----------------------------------------------------------------------------
ADMIN_APP_NAME="007 Resort & Spa Admin"
ADMIN_APP_ENV=production
ADMIN_APP_KEY=<secret>                       # php artisan key:generate --show
ADMIN_APP_DEBUG=false
ADMIN_APP_URL=https://admin.site.local
ADMIN_R007_API_BASE_URL=https://r007-api.site.local:5443
ADMIN_R007_API_CLIENT_ID=007resort-admin-web
ADMIN_R007_DISPLAY_TIMEZONE=Africa/Lagos
ADMIN_SESSION_DRIVER=file
ADMIN_SESSION_SECURE_COOKIE=true
ADMIN_CACHE_STORE=file
ADMIN_QUEUE_CONNECTION=sync
# NOTE: in the admin-web .env these keys are written without the ADMIN_ prefix.

# -----------------------------------------------------------------------------
# 007resort-booking-web - NOT deployed on-site (cloud only).
# -----------------------------------------------------------------------------
