# =============================================================================
# Otueke - ON-SITE deployment environment template
# =============================================================================
# PLACEHOLDERS ONLY. Real values live in the site server's protected
# environment (Windows service environment / machine-level env vars readable
# only by the service account) or a secret store - NEVER in git.
#
# Host: Windows local application server (SERVER VLAN).
# Services: Otueke API (Windows service), MySQL 8.4, Redis (optional),
#           otueke-admin-web (local management UI).
# Values marked <secret> must be generated per site and stored securely.
# =============================================================================

# -----------------------------------------------------------------------------
# Otueke API (ASP.NET Core, runs as a Windows service)
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# Bind on the SERVER VLAN interface only (not 0.0.0.0 if avoidable).
ASPNETCORE_URLS=https://0.0.0.0:5443;http://0.0.0.0:5080
# Deployment mode: "site" (local-first, authoritative for on-site operations)
OTUEKE__DEPLOYMENTMODE=site
# Identifier of this property/site as registered in the cloud.
OTUEKE__SITEID=SITE-PLACEHOLDER-001
OTUEKE__TIMEZONE=Africa/Lagos

# MySQL connection (application user; least privilege on the otueke schema).
ConnectionStrings__Otueke=Server=127.0.0.1;Port=3306;Database=otueke;User ID=otueke_app;Password=<secret>;SslMode=Preferred;
# Migration user (DDL rights) used ONLY by the deployment step, not the running service.
# ConnectionStrings__OtuekeMigrations=Server=127.0.0.1;Port=3306;Database=otueke;User ID=otueke_migrator;Password=<secret>;

# Optional Redis (caching / pub-sub for KDS). Leave empty to disable.
ConnectionStrings__Redis=127.0.0.1:6379,password=<secret>,abortConnect=false

# Token signing - generate per site (min 256-bit random). Rotate per runbook.
OTUEKE__AUTH__SIGNINGKEY=<secret>
OTUEKE__AUTH__ISSUER=https://otueke-api.site.local
OTUEKE__AUTH__ACCESSTOKENMINUTES=30

# TLS certificate for the API (path to a PFX outside the repo; password in secret store).
OTUEKE__TLS__CERTIFICATEPATH=C:\Otueke\certs\otueke-api.pfx
OTUEKE__TLS__CERTIFICATEPASSWORD=<secret>

# Cloud sync (OUTBOUND ONLY from site to cloud; the site accepts no inbound internet traffic).
OTUEKE__SYNC__ENABLED=true
OTUEKE__SYNC__CLOUDBASEURL=https://api.cloud.example.com
OTUEKE__SYNC__SITECLIENTID=site-placeholder-001
OTUEKE__SYNC__SITECLIENTSECRET=<secret>
OTUEKE__SYNC__INTERVALSECONDS=30

# Logging
Serilog__MinimumLevel__Default=Information
OTUEKE__LOGGING__PATH=C:\Otueke\logs\api

# -----------------------------------------------------------------------------
# MySQL 8.4 (local)
# -----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=otueke
# Backups read credentials from a protected option file - never from here.
MYSQL_BACKUP_OPTION_FILE=C:\Otueke\secrets\mysql-backup.cnf
BACKUP_LOCAL_PATH=D:\OtuekeBackups
BACKUP_NAS_PATH=\\nas.site.local\otueke-backups
BACKUP_RETENTION_DAYS=35

# -----------------------------------------------------------------------------
# otueke-admin-web (local management UI, STAFF VLAN access only)
# -----------------------------------------------------------------------------
ADMIN_APP_NAME="Otueke Admin"
ADMIN_APP_ENV=production
ADMIN_APP_KEY=<secret>                       # php artisan key:generate --show
ADMIN_APP_DEBUG=false
ADMIN_APP_URL=https://admin.site.local
ADMIN_OTUEKE_API_BASE_URL=https://otueke-api.site.local:5443
ADMIN_OTUEKE_API_CLIENT_ID=otueke-admin-web
ADMIN_OTUEKE_DISPLAY_TIMEZONE=Africa/Lagos
ADMIN_SESSION_DRIVER=file
ADMIN_SESSION_SECURE_COOKIE=true
ADMIN_CACHE_STORE=file
ADMIN_QUEUE_CONNECTION=sync
# NOTE: in the admin-web .env these keys are written without the ADMIN_ prefix.

# -----------------------------------------------------------------------------
# otueke-booking-web - NOT deployed on-site (cloud only).
# -----------------------------------------------------------------------------
