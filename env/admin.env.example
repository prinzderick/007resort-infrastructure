# =============================================================================
# 007 Resort & Spa - ADMIN PORTAL (007resort-admin-web) on the Cloud VPS - Laravel .env template
# =============================================================================
# PLACEHOLDERS ONLY. The real file lives at /var/www/r007/admin/shared/.env
# (owner deploy, group r007-admin, mode 640). NEVER commit it.
# scripts/vps/provision-stack.sh creates it from this template and fills the <generate> values / URLs.
# Keep in step with 007resort-admin-web/.env.example. No database: staff sign in with their API credentials and
# the API access token stays server-side in the (encrypted) session.
# =============================================================================

APP_NAME="007 Resort & Spa Admin"
APP_ENV=production
APP_DEBUG=false
APP_KEY=<generate>                          # deploy.sh generates it on the first deploy if empty
APP_URL=https://admin.example.com           # https://<ADMIN_DOMAIN>
R007_DISPLAY_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

# ---- Instance ------------------------------------------------------------------------
R007_INSTANCE=cloud                         # remote admin (Owner/Manager/Accounts/IT)
R007_MFA_ENFORCE=false                      # set true once the API can verify a second factor
R007_ME_TTL=300
R007_MOCK=false                             # NEVER true in production (fixture data, password "password")
R007_MOCK_SCENARIO=normal
R007_SITE_URL=https://example.com           # "preview on site" links in the Website area

# ---- The API ---------------------------------------------------------------------------
# Default = public HTTPS URL. Loopback alternative (same box only): http://127.0.0.1:8088
R007_API_BASE_URL=https://api.example.com
R007_API_PREFIX=/api/v1
R007_API_TIMEOUT=10
R007_API_CONNECT_TIMEOUT=3
R007_API_CLIENT_ID=007resort-admin-web

# ---- Sessions / cache: files under this app's own storage -------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null                         # host-only cookie: never shared with the public site or the API
SESSION_COOKIE=r007_admin_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=r007_admin_

# ---- Behind nginx: HTTPS=on is passed to PHP-FPM. Add TRUSTED_PROXIES only if the app reads it. ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"
