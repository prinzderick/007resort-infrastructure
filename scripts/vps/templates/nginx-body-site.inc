# Managed by 007resort-infrastructure. Body of the public website server (@@DOMAIN@@).
include @@NGINX_ETC@@/snippets/r007-common.conf;
include @@NGINX_ETC@@/snippets/r007-@@APP@@-headers.conf;
root @@APP_DIR@@/current/public;
client_max_body_size 4m;

location ~ /\.(?!well-known) { deny all; }

# Vite output is content-hashed: cache forever.
location ^~ /build/ {
    include @@NGINX_ETC@@/snippets/r007-@@APP@@-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    access_log off;
    try_files $uri =404;
}
location ~* \.(?:css|js|mjs|woff2?|ttf|png|jpe?g|gif|webp|avif|svg|ico|webmanifest)$ {
    include @@NGINX_ETC@@/snippets/r007-@@APP@@-headers.conf;
    add_header Cache-Control "public, max-age=604800" always;
    access_log off;
    try_files $uri =404;
}

# robots.txt and sitemap.xml are generated by Laravel (SeoController): never serve a stale static copy.
location ~ ^/(?:robots\.txt|sitemap\.xml)$ {
    try_files /_r007_no_static_file /index.php?$query_string;
}

location / {
    try_files $uri $uri/ /index.php?$query_string;
}

include @@NGINX_ETC@@/snippets/r007-@@APP@@-php.conf;
